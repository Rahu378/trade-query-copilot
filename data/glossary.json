{"terms":[{"term":"Traded position","aliases":["traded quantity","trade-date position","book position"],"definition":"Quantity on a trade-date basis. A trade counts the moment it's booked, settled or not. This is what the front office and the IBOR show.\n","maps_to":"positions.traded_quantity"},{"term":"Settled position","aliases":["settled quantity","custody position","settlement-date position"],"definition":"Quantity that has actually settled at the custodian. Lags the traded position by the settlement cycle (T+1 for US and Canada, T+2 for everything else in this data) and by any fails.\n","maps_to":"positions.settled_quantity"},{"term":"Unsettled quantity","aliases":["unsettled position","pending quantity"],"definition":"Traded minus settled quantity. Only lines where the two differ.","maps_to":"SUM(positions.traded_quantity - positions.settled_quantity) WHERE traded_quantity <> settled_quantity"},{"term":"Base-currency market value","aliases":["market value","MV","base MV","USD market value","exposure"],"definition":"Traded quantity x closing price, converted to USD (every fund here has a USD base) at the daily rate. Bond prices are per 100 of face.\n","maps_to":"positions.market_value_usd","rule":"Use the latest snapshot (as_of_date = '2026-11-20') unless the question names a date."},{"term":"Settled market value","aliases":["settled MV"],"definition":"Settled quantity valued the same way. Traded minus settled MV is the value still in flight.","maps_to":"positions.settled_market_value_usd"},{"term":"Position / holding","aliases":["positions","holdings","line"],"definition":"An account and security with a non-zero traded quantity. \"Hold\" means long (traded quantity > 0).","maps_to":"positions WHERE traded_quantity <> 0"},{"term":"Notional","aliases":["trade size","trade value","amount traded","volume"],"definition":"Quantity x price, converted to USD at the trade-date rate.","maps_to":"trades.notional_usd"},{"term":"Large trade","aliases":["big ticket","over $1M"],"definition":"USD notional above 1,000,000.","maps_to":"trades.notional_usd > 1000000"},{"term":"Active trades","definition":"Trade activity (counts, notional, averages) excludes cancelled trades unless you ask about cancellations.","maps_to":"trades.trade_status <> 'CANCELLED'"},{"term":"Failed trade","aliases":["fail","failed to settle","failing trade"],"definition":"Past its expected settlement date and still not settled. A trade that failed and then settled late is SETTLED now, but keeps its fail_reason.\n","maps_to":"settlements.settlement_status = 'FAILED'"},{"term":"Pending settlement","aliases":["awaiting settlement","not yet due"],"definition":"Booked, not yet due to settle.","maps_to":"settlements.settlement_status = 'PENDING'"},{"term":"Settled on time","definition":"Settled on the expected settlement date.","maps_to":"settlements.settlement_status = 'SETTLED' AND actual_settle_date = expected_settle_date"},{"term":"Settlement window","definition":"When a question about failing, settling or pending gives a time window (\"failed this week\"), the window applies to the expected settlement date, not the trade date.\n","maps_to":"settlements.expected_settle_date"},{"term":"Break status","aliases":["open break","resolved break"],"definition":"OPEN and INVESTIGATING both count as open. RESOLVED is closed.","maps_to":"breaks.break_status"},{"term":"Aged break","aliases":["stale break","old break"],"definition":"Open break older than five business days.","maps_to":"breaks.break_status IN ('OPEN', 'INVESTIGATING') AND breaks.age_days > 5"},{"term":"Break amount","definition":"Absolute USD value of the difference between IBOR and custodian.","maps_to":"breaks.amount_usd"},{"term":"Counterparty tier","definition":"Internal credit tier. 1 is strongest, 3 is on the watch list.","maps_to":"counterparties.tier"},{"term":"Relative dates","definition":"The data is a snapshot at Friday 2026-11-20. Today = 2026-11-20, yesterday = 2026-11-19, this week = 2026-11-16..2026-11-20, last week = 2026-11-09..2026-11-13, this month = 2026-11-01..2026-11-20.\n"}],"value_aliases":{"asset_class":{"EQUITY":["equity","equities","stock","stocks"],"ETF":["etf","etfs","exchange traded fund","exchange traded funds"],"GOVT_BOND":["government bond","government bonds","govt bond","govt bonds","govies","treasuries","treasury","sovereign","sovereigns","gilts","bunds","jgbs"],"CORP_BOND":["corporate bond","corporate bonds","corporates","credit bonds","corp bonds"],"BOND":["bond","bonds","fixed income securities"]},"side":{"BUY":["buy","buys","bought","purchase","purchases","purchased"],"SELL":["sell","sells","sold","sale","sales"]},"country":{"GB":["uk","u.k.","british","united kingdom","london"],"US":["american","us-based","u.s."],"DE":["german","germany"],"FR":["french","france"],"JP":["japanese","japan"],"CH":["swiss","switzerland"]},"currency":{"USD":["usd","dollar","dollars","us dollar"],"EUR":["eur","euro","euros","eur-denominated","euro-denominated"],"GBP":["gbp","sterling","pound","pounds"],"JPY":["jpy","yen"]},"break_type":{"POSITION":["position break","position breaks","quantity break","quantity breaks"],"CASH":["cash break","cash breaks"],"PRICE":["price break","price breaks","pricing break","pricing breaks","valuation break","valuation breaks"]},"root_cause":{"TIMING":["timing"],"MISSED_CA":["missed corporate action","missed corporate actions","missed ca","corporate action"],"STALE_PRICE":["stale price","stale prices","stale pricing"],"FX":["fx break","fx breaks","fx issue"],"FAILED_SETTLEMENT":["failed settlement root cause","settlement fail breaks"],"BOOKING_ERROR":["booking error","booking errors","misbooking","mis-booking"]},"owner_team":{"Settlements":["settlements team","settlements"],"Corporate Actions":["corporate actions team","ca team","corporate actions"],"Pricing & Valuations":["pricing team","pricing","valuations"],"Market Data - FX":["market data","fx team"],"Trade Support":["trade support"],"Reconciliations":["reconciliations","recs team","recs"]},"sector":{"Technology":["technology","tech"],"Financials":["financials","banks"],"Health Care":["health care","healthcare","pharma"],"Energy":["energy","oil"],"Consumer Staples":["consumer staples","staples"],"Consumer Discretionary":["consumer discretionary"],"Communication Services":["communication services","communications","media"],"Industrials":["industrials"]}}}